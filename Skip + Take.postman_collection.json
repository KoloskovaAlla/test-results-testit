					"});\r",
					"\r",
					"pm.test(\"Returned correct number of items based on Take parameter\", function () {\r",
					"    // Получаем значение параметра Take из URL запроса\r",
					"    const takeParam = pm.request.url.query.get('Take');\r",
					"    \r",
					"    // Преобразуем в число (параметр приходит как строка)\r",
					"    const expectedCount = parseInt(takeParam);\r",
					"    \r",
					"    // Получаем ответ и проверяем количество элементов\r",
					"    const responseJson = pm.response.json();\r",
					"    const actualCount = responseJson.length;\r",
					"    \r",
					"    // Выводим информацию для отладки\r",
					"    console.log('Take parameter from URL:', takeParam);\r",
					"    console.log('Expected items count:', expectedCount);\r",
					"    console.log('Actual items count:', actualCount);\r",
					"    \r",
					"    // Проверяем соответствие\r",
