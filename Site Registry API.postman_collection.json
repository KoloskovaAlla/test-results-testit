		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"pm.test(\"Status code is 200\", function () {\r",
					"    pm.response.to.have.status(200);\r",
					"});\r",
					"\r",
					"pm.test(\"Response time is acceptable\", function () {\r",
					"    pm.expect(pm.response.responseTime).to.be.below(10000);\r",
					"});\r",
					"\r",
					"pm.test(\"Response structure is valid\", function () {\r",
					"    const sites = pm.response.json();\r",
					"    pm.expect(sites).to.be.an('array');\r",
					"});\r",
					"\r",
					"pm.test(\"SearchString filter works correctly\", function () {\r",
					"    const searchString = pm.request.url.query.get(\"SearchString\");\r",
					"    const sites = pm.response.json();\r",
					"    \r",
					"    console.log(`Searching for: \"${searchString}\"`);\r",
					"    console.log(`Found ${sites.length} sites`);\r",
					"    \r",
					"    sites.forEach((site, index) => {\r",
					"        const nameContains = site.name.toLowerCase().includes(searchString.toLowerCase());\r",
					"        console.log(`Site ${index + 1}: ${site.name} - Contains \"${searchString}\": ${nameContains}`);\r",
					"        \r",
					"        pm.expect(nameContains, \r",
					"            `Site \"${site.name}\" should contain search string \"${searchString}\"`\r",
					"        ).to.be.true;\r",
					"    });\r",
					"});"
				]
			}
		}
