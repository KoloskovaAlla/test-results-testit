	"item": [
		{
			"name": "SiteRegistry/general",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Статус ответа 200 ОК\", function () {\r",
							"    pm.response.to.have.status('OK');\r",
							"});\r",
							"\r",
							"const jsonResponse = pm.response.json();\r",
							"\r",
							"pm.test(\"Ответ содержит все необходимые поля\", function () {\r",
							"    pm.expect(jsonResponse).to.have.property(\"totalCount\")\r",
							"    pm.expect(jsonResponse).to.have.property(\"totalInvalidCount\")\r",
							"    pm.expect(jsonResponse).to.have.property(\"totalImportantCount\")\r",
							"    pm.expect(jsonResponse).to.have.property(\"totalCollectingSitesCount\")\r",
							"});\r",
							"\r",
							"const totalCount = jsonResponse.totalCount;\r",
							"const totalInvalidCount = jsonResponse.totalInvalidCount;\r",
							"const totalImportantCount = jsonResponse.totalImportantCount;\r",
							"const totalCollectingSitesCount = jsonResponse.totalCollectingSitesCount;\r",
							"\r",
							"pm.test(\"Все поля имеют числовые значения, больше или равные нулю\", function () {\r",
							"    pm.expect(totalCount).to.be.a('number');\r",
							"    pm.expect(totalInvalidCount).to.be.a('number');\r",
							"    pm.expect(totalImportantCount).to.be.a('number');\r",
							"    pm.expect(totalCollectingSitesCount).to.be.a('number');    \r",
							"    pm.expect(totalCount).to.be.above(0); \r",
							"    pm.expect(totalInvalidCount).to.be.at.least(0);\r",
							"    pm.expect(totalImportantCount).to.be.at.least(0);\r",
							"    pm.expect(totalCollectingSitesCount).to.be.at.least(0);\r",
							"});\r",
							"\r",
							"pm.test(\"Количество сайтов с поломкой не превышает общее количество сайтов\", function () {\r",
							"    pm.expect(totalCount).to.be.at.least(totalInvalidCount);   \r",
							"});\r",
							"\r",
							"pm.test(\"Количество важных сайтов не превышает общее количество сайтов\", function () { \r",
							"    pm.expect(totalCount).to.be.at.least(totalImportantCount); \r",
							"});\r",
							"\r",
							"pm.test(\"Количество сайтов с включенным сбором не превышает общее количество сайтов\", function () {   \r",
							"    pm.expect(totalCount).to.be.at.least(totalCollectingSitesCount);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
