	"item": [
		{
			"name": "OnlyImportant=true",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Фильтрация по OnlyImportant соответствует параметру\", function () {\r",
							"    const sites = pm.response.json();\r",
							"    const onlyImportant = pm.request.url.query.get('OnlyImportant');\r",
							"    const boolValue = onlyImportant === 'true'    \r",
							"    const isAvaliable = sites.every(site => site.isImportant === boolValue);\r",
							"\r",
							"    pm.expect(isAvaliable).to.equal(true);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "http://rest.test.m13.local/api/spider/SiteRegistry/sites?OnlyImportant=true",
