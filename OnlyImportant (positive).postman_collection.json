		{
			"name": "без параметра",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Без параметра OnlyImportant возвращаются сайты всех типов\", function () {\r",
							"    const sites = pm.response.json();\r",
							"    \r",
							"    const trueCount = sites.filter(s => s.isImportant === true).length;\r",
							"    const falseCount = sites.filter(s => s.isImportant === false).length;\r",
							"    \r",
							"    pm.expect(trueCount).to.be.above(0);\r",
							"    pm.expect(falseCount).to.be.above(0);\r",
							"    \r",
							"    console.log(`Important: ${trueCount}, Not important: ${falseCount}`);\r",
							"});"
