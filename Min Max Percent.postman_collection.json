				"exec": [
					"const minPercent = Number(pm.request.url.query.get(\"MinimumPercent\"));\r",
					"const maxPercent = Number(pm.request.url.query.get(\"MaximumPercent\"));\r",
					"\r",
					"pm.test(`Значение breakdownPercentage находится в требуемом диапазоне между ${minPercent} и ${maxPercent}`, function () {\r",
					"    const sites = pm.response.json()\r",
					"    sites.forEach(function(site) {\r",
					"        // здесь проверяем каждый site\r",
					"        // const minPercent = Number(pm.request.url.query.get(\"MinimumPercent\"));\r",
					"        // const maxPercent = Number(pm.request.url.query.get(\"MaximumPercent\"));\r",
					"        // console.log(minPercent);\r",
					"        // console.log(maxPercent);\r",
					"        // console.log(site.breakdownPercentage);\r",
					"        const isBreakdownPercentageAvaliable = minPercent <= site.breakdownPercentage && site.breakdownPercentage <= maxPercent;   \r",
					"        // console.log(isBreakdownPercentageAvaliable);\r",
					"        pm.expect(isBreakdownPercentageAvaliable).to.equal(true);\r",
					"      \r",
					"    });\r",
					"});"
